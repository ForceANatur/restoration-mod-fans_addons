<?xml version="1.0"?>
<unit type="wpn" slot="13">
  <object file="units/payday2/weapons/wpn_npc_m79/wpn_npc_m79" />
  <dependencies>
   <depends_on bnk="soundbanks/weapon_gl40"/>
  </dependencies>
