<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/payday2/weapons/wpn_npc_m95/wpn_npc_m95" orientation_object="rp_wpn_npc_m95" />
  <sequence_manager file="units/payday2/weapons/wpn_npc_m95/wpn_npc_m95" />
  <bodies>
    <body name="body" enabled="false" template="debris" pushed_by_mover="false">
		<object name="rp_wpn_npc_m95" />
		<object name="c_box" collision_type="box" mass="2.5" />
    </body>
  </bodies>
  
  <graphics>
	<graphic_group name="lod_group" enabled="true" culling_object="co_weapon">
      <lod_object name="weapon_lod">
        <object  name="g_m95" enabled="true" max_draw_lod="0" max_distance="1000" />
        <object lod="1" name="g_m95_lod1" enabled="true" />
      </lod_object>
    </graphic_group>
  </graphics>

  
  <lights>
    <light multiplier="identity" far_range="1000" name="ls_flashlight" enabled="false" type="spot|specular" />
  </lights>  
</dynamic_object>
