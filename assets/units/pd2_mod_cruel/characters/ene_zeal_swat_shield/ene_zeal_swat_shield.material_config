<materials version="3" group="ene_zeal_swat_shield">
	<material name="mtr_head" render_template="generic:DIFFUSE_TEXTURE:NORMALMAP:RL_COPS:SELF_ILLUMINATION:SELF_ILLUMINATION_BLOOM:SKINNED_3WEIGHTS" version="2">
		<bump_normal_texture 	file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_head_nm"/>
		<diffuse_texture 		file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_head_df"/>
		<self_illumination_texture file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_head_il"/> <!--insert the IL texture in this line-->
		<variable type="scalar" name="il_bloom" value="5"/> <!--try values between 1 to 5-->
        <variable type="scalar" name="il_multiplier" value="neonsign"/> <!--this has to be very specific words, try neonsign, searchlight, reddot or sun--> 
	</material>

	<!--notice the different render_template variable here, this is because the helmet is not rigged (as in, it doesn't bend or move, in layman's terms) 
		and therefore has no skeletal weights-->
	<material name="mtr_helmet" render_template="generic:DIFFUSE_TEXTURE:NORMALMAP:SELF_ILLUMINATION:SELF_ILLUMINATION_BLOOM" version="2">
		<bump_normal_texture 	file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_mask_nm"/>
		<diffuse_texture 		file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_mask_df"/>
		<self_illumination_texture file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_mask_il"/>
		<variable type="scalar" name="il_bloom" value="5"/> 
        <variable type="scalar" name="il_multiplier" value="neonsign"/>
	</material>
	
	<material name="mtr_swat" render_template="generic:DIFFUSE_TEXTURE:NORMALMAP:RL_COPS:SELF_ILLUMINATION:SELF_ILLUMINATION_BLOOM:SKINNED_3WEIGHTS" version="2">
		<bump_normal_texture 	file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_nm"/>
		<diffuse_texture 		file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_df"/>
		<self_illumination_texture file="units/pd2_mod_cruel/characters/ene_zeal_swat_shield/ene_zeal_swat_il"/>
		<variable type="scalar" name="il_bloom" value="5"/> 
        <variable type="scalar" name="il_multiplier" value="neonsign"/>
	</material>
	
    <material name="shadow_caster" render_template="shadow_caster_only:SKINNED_1WEIGHT" version="2"/>
</materials>