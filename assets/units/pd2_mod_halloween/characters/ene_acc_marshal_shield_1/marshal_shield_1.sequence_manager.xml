<sequence_manager>
	<unit>
		<variables>
			<var_light_1_state value="1"/>
			<var_light_2_state value="1"/>
			<var_shield_state value="1"/>
			<var_charging_1_state value="0"/>
			<var_charging_2_state value="0"/>
			<var_part_01 value="0"/>
			<var_part_02 value="0"/>
			<var_part_03 value="0"/>
			<var_part_04 value="0"/>
			<var_part_05 value="0"/>
			<var_part_06 value="0"/>
			<var_loop_break value="0"/>
		</variables>
		<filter name="'filter_loop_break'">
			<check value="vars.var_loop_break == 0"/>
		</filter>
		<filter name="'filter_part_01'">
			<check value="vars.var_part_01 == 0"/>
		</filter>
		<filter name="'filter_already_part_01'">
			<check value="vars.var_part_01 >= 1"/>
		</filter>
		<filter name="'filter_part_02'">
			<check value="vars.var_part_02 == 0"/>
		</filter>
		<filter name="'filter_already_part_02'">
			<check value="vars.var_part_02 >= 1"/>
		</filter>
		<filter name="'filter_part_03'">
			<check value="vars.var_part_03 == 0"/>
		</filter>
		<filter name="'filter_already_part_03'">
			<check value="vars.var_part_03 >= 1"/>
		</filter>
		<filter name="'filter_part_04'">
			<check value="vars.var_part_04 == 0"/>
		</filter>
		<filter name="'filter_already_part_04'">
			<check value="vars.var_part_04 >= 1"/>
		</filter>
		<filter name="'filter_part_05'">
			<check value="vars.var_part_05 == 0"/>
		</filter>
		<filter name="'filter_already_part_05'">
			<check value="vars.var_part_05 >= 1"/>
		</filter>
		<filter name="'filter_part_06'">
			<check value="vars.var_part_06 == 0"/>
		</filter>
		<filter name="'filter_already_part_06'">
			<check value="vars.var_part_06 >= 1"/>
		</filter>
		<filter name="'filter_already_all_parts'">
			<check value="vars.var_part_01 >= 1"/>
			<check value="vars.var_part_02 >= 1"/>
			<check value="vars.var_part_03 >= 1"/>
			<check value="vars.var_part_04 >= 1"/>
			<check value="vars.var_part_05 >= 1"/>
			<check value="vars.var_part_06 >= 1"/>
		</filter>
		<filter name="'filter_light_1_disabled'">
			<check value="vars.var_light_1_state == 0"/>
		</filter>
		<filter name="'filter_light_1_enabled'">
			<check value="vars.var_light_1_state == 1"/>
		</filter>
		<filter name="'filter_light_1_charging'">
			<check value="vars.var_charging_1_state == 1"/>
		</filter>
		<filter name="'filter_light_2_disabled'">
			<check value="vars.var_light_2_state == 0"/>
		</filter>
		<filter name="'filter_light_2_enabled'">
			<check value="vars.var_light_2_state == 1"/>
		</filter>
		<filter name="'filter_light_2_charging'">
			<check value="vars.var_charging_2_state == 1"/>
		</filter>
		<filter name="'filter_shield_broken'">
			<check value="vars.var_shield_state == 0"/>
		</filter>
		<filter name="'filter_shield_not_broken'">
			<check value="vars.var_shield_state == 1"/>
		</filter>
		<filter check_all="true" name="'filter_can_flash_start_only_light_1'">
			<check value="vars.var_shield_state == 1"/>
			<check value="vars.var_light_1_state == 1"/>
			<check value="vars.var_light_2_state == 0"/>
		</filter>
		<filter check_all="true" name="'filter_can_flash_start_only_light_2'">
			<check value="vars.var_shield_state == 1"/>
			<check value="vars.var_light_1_state == 0"/>
			<check value="vars.var_light_2_state == 1"/>
		</filter>
		<filter check_all="true" name="'filter_can_flash_start_both_lights'">
			<check value="vars.var_shield_state == 1"/>
			<check value="vars.var_light_1_state == 1"/>
			<check value="vars.var_light_2_state == 1"/>
		</filter>
		<filter check_all="true" name="'filter_can_flash_light_1'">
			<check value="vars.var_shield_state == 1"/>
			<check value="vars.var_light_1_state == 1"/>
			<check value="vars.var_charging_1_state == 1"/>
		</filter>
		<filter check_all="true" name="'filter_can_flash_light_2'">
			<check value="vars.var_shield_state == 1"/>
			<check value="vars.var_light_2_state == 1"/>
			<check value="vars.var_charging_2_state == 1"/>
		</filter>
		<sequence name="'enable_body'" triggable="true">
			<body enabled="false" name="'held_body'"/>
			<body enabled="true" name="'dropped_body'"/>
			<run_sequence filter="'filter_light_1_enabled'" name="'disable_light_1_blink'"/>
			<run_sequence filter="'filter_light_2_enabled'" name="'disable_light_2_blink'"/>
		</sequence>
		<sequence editable_state="false" name="'disable_light_1'" triggable="true">
			<body enabled="false" name="'light_01'"/>
			<object enabled="false" name="'g_light_01'"/>
			<function extension="'base'" filter="'filter_light_1_charging'" function="'clbk_seq_chk_interrupt_flash'" param1="object('e_01')"/>
			<set_variables var_light_1_state="0"/>
			<set_variables var_charging_1_state="0"/>
		</sequence>
		<sequence editable_state="false" name="'disable_light_2'" triggable="true">
			<body enabled="false" name="'light_02'"/>
			<object enabled="false" name="'g_light_02'"/>
			<function extension="'base'" filter="'filter_light_2_charging'" function="'clbk_seq_chk_interrupt_flash'" param1="object('e_02')"/>
			<set_variables var_light_2_state="0"/>
			<set_variables var_charging_2_state="0"/>
		</sequence>
		<sequence editable_state="false" name="'disable_light_1_blink'" triggable="true">
			<body enabled="false" name="'light_01'"/>
			<object enabled="false" name="'g_light_01'"/>
			<object enabled="true" name="'g_light_01'" start_time="0.1"/>
			<object enabled="false" name="'g_light_01'" start_time="0.2"/>
			<object enabled="true" name="'g_light_01'" start_time="0.3"/>
			<object enabled="false" name="'g_light_01'" start_time="0.6"/>
			<function extension="'base'" filter="'filter_light_1_charging'" function="'clbk_seq_chk_interrupt_flash'" param1="object('e_01')"/>
			<set_variables var_light_1_state="0"/>
			<set_variables var_charging_1_state="0"/>
		</sequence>
		<sequence editable_state="false" name="'disable_light_2_blink'" triggable="true">
			<body enabled="false" name="'light_02'"/>
			<object enabled="false" name="'g_light_02'"/>
			<object enabled="true" name="'g_light_02'" start_time="0.1"/>
			<object enabled="false" name="'g_light_02'" start_time="0.2"/>
			<object enabled="true" name="'g_light_02'" start_time="0.3"/>
			<object enabled="false" name="'g_light_02'" start_time="0.6"/>
			<function extension="'base'" filter="'filter_light_2_charging'" function="'clbk_seq_chk_interrupt_flash'" param1="object('e_02')"/>
			<set_variables var_light_2_state="0"/>
			<set_variables var_charging_2_state="0"/>
		</sequence>
		<sequence editable_state="false" name="'int_seq_light_1_hit'" triggable="false">
			<object enabled="false" name="'g_light_01'"/>
			<object delayed_filter="'filter_light_1_enabled'" enabled="true" name="'g_light_01'" start_time="0.1"/>
			<object delayed_filter="'filter_light_1_enabled'" enabled="false" name="'g_light_01'" start_time="0.2"/>
			<object delayed_filter="'filter_light_1_enabled'" enabled="true" name="'g_light_01'" start_time="0.3"/>
			<effect name="'effects/particles/dest/security_camera_dest'" parent="'e_01'"/>
		</sequence>
		<sequence editable_state="false" name="'int_seq_light_2_hit'" triggable="false">
			<object enabled="false" name="'g_light_02'"/>
			<object delayed_filter="'filter_light_2_enabled'" enabled="true" name="'g_light_02'" start_time="0.1"/>
			<object delayed_filter="'filter_light_2_enabled'" enabled="false" name="'g_light_02'" start_time="0.2"/>
			<object delayed_filter="'filter_light_2_enabled'" enabled="true" name="'g_light_02'" start_time="0.3"/>
			<effect name="'effects/particles/dest/security_camera_dest'" parent="'e_02'"/>
		</sequence>
		<sequence editable_state="false" name="'int_seq_light_1_break'" once="true" triggable="false">
			<sound action="'play'" event="'USM_Bulb_BRK'" object="'c_light_01'"/>
			<effect align="object_rot('e_01')" damp_time="4" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" position="object_pos('e_01')"/>
			<effect align="object_rot('e_01')" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" position="object_pos('e_01')"/>
			<function extension="'base'" filter="'filter_light_1_charging'" function="'clbk_seq_chk_interrupt_flash_hit'" param1="object_pos('e_01')" param2="object_rot_y('e_01')" param3="src_unit_unit()" param4="1"/>
			<run_sequence name="'disable_light_1_blink'"/>
		</sequence>
		<sequence editable_state="false" name="'int_seq_light_2_break'" once="true" triggable="false">
			<sound action="'play'" event="'USM_Bulb_BRK'" object="'c_light_02'"/>
			<effect align="object_rot('e_02')" damp_time="4" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" position="object_pos('e_02')"/>
			<effect align="object_rot('e_02')" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" position="object_pos('e_02')"/>
			<function extension="'base'" filter="'filter_light_2_charging'" function="'clbk_seq_chk_interrupt_flash_hit'" param1="object_pos('e_02')" param2="object_rot_y('e_02')" param3="src_unit_unit()" param4="2"/>
			<run_sequence name="'disable_light_2_blink'"/>
		</sequence>
		<sequence editable_state="false" name="'int_seq_shield_break'" once="true" triggable="true">
			<set_variables var_shield_state="0"/>
			<run_sequence filter="'filter_light_1_enabled'" name="'disable_light_1'"/>
			<run_sequence filter="'filter_light_2_enabled'" name="'disable_light_2'"/>
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<function extension="'damage'" function="'parent_function'" param1="'inventory'" param2="'on_shield_break'" param3="src_unit_unit()"/>
		</sequence>
		<sequence editable_state="false" name="'verify_start_flash'" triggable="false">
			<run_sequence filter="'filter_can_flash_start_only_light_1'" name="'start_flash_light_1'"/>
			<run_sequence filter="'filter_can_flash_start_only_light_2'" name="'start_flash_light_2'"/>
			<run_sequence filter="'filter_can_flash_start_both_lights'" name="'start_flash_light_'..pick('1','2')"/>
		</sequence>
		<sequence editable_state="false" name="'start_flash_light_1'" triggable="false">
			<set_variables var_charging_1_state="1"/>
			<function extension="'base'" function="'clbk_seq_flash_start'" param1="object('e_01')" param2="body('light_01')" param3="1"/>
		</sequence>
		<sequence editable_state="false" name="'start_flash_light_2'" triggable="false">
			<set_variables var_charging_2_state="1"/>
			<function extension="'base'" function="'clbk_seq_flash_start'" param1="object('e_02')" param2="body('light_02')" param3="2"/>
		</sequence>
		<sequence editable_state="false" name="'verify_flash'" triggable="false">
			<run_sequence filter="'filter_can_flash_light_1'" name="'flash_light_1'"/>
			<run_sequence filter="'filter_can_flash_light_2'" name="'flash_light_2'"/>
		</sequence>
		<sequence editable_state="false" name="'flash_light_1'" triggable="false">
			<set_variables var_charging_1_state="0"/>
			<function extension="'base'" function="'clbk_seq_flash'" param1="object_pos('e_01')" param2="object_rot_y('e_01')"/>
		</sequence>
		<sequence editable_state="false" name="'flash_light_2'" triggable="false">
			<set_variables var_charging_2_state="0"/>
			<function extension="'base'" function="'clbk_seq_flash'" param1="object_pos('e_02')" param2="object_rot_y('e_02')"/>
		</sequence>
		<sequence editable_state="false" name="'spawn_debris_1'" triggable="false">
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<object enabled="false" name="'g_shield_debris_1'"/>
			<spawn_unit inherit_destroy="true" name="'units/pd2_mod_halloween/characters/ene_acc_marshal_shield_1/marshal_shield_debris_1'" position="object_pos('rp_marshal_shield_1')" rotation="object_rot('rp_marshal_shield_1')"/>
			<set_variables var_part_01="1"/>
		</sequence>
		<sequence editable_state="false" name="'spawn_debris_2'" triggable="false">
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<object enabled="false" name="'g_shield_debris_2'"/>
			<spawn_unit inherit_destroy="true" name="'units/pd2_mod_halloween/characters/ene_acc_marshal_shield_1/marshal_shield_debris_2'" position="object_pos('rp_marshal_shield_1')" rotation="object_rot('rp_marshal_shield_1')"/>
			<set_variables var_part_02="1"/>
		</sequence>
		<sequence editable_state="false" name="'spawn_debris_3'" triggable="false">
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<object enabled="false" name="'g_shield_debris_3'"/>
			<spawn_unit inherit_destroy="true" name="'units/pd2_mod_halloween/characters/ene_acc_marshal_shield_1/marshal_shield_debris_3'" position="object_pos('rp_marshal_shield_1')" rotation="object_rot('rp_marshal_shield_1')"/>
			<set_variables var_part_03="1"/>
		</sequence>
		<sequence editable_state="false" name="'spawn_debris_4'" triggable="false">
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<object enabled="false" name="'g_shield_debris_4'"/>
			<spawn_unit inherit_destroy="true" name="'units/pd2_mod_halloween/characters/ene_acc_marshal_shield_1/marshal_shield_debris_4'" position="object_pos('rp_marshal_shield_1')" rotation="object_rot('rp_marshal_shield_1')"/>
			<set_variables var_part_04="1"/>
		</sequence>
		<sequence editable_state="false" name="'spawn_debris_5'" triggable="false">
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<object enabled="false" name="'g_shield_debris_5'"/>
			<spawn_unit inherit_destroy="true" name="'units/pd2_mod_halloween/characters/ene_acc_marshal_shield_1/marshal_shield_debris_5'" position="object_pos('rp_marshal_shield_1')" rotation="object_rot('rp_marshal_shield_1')"/>
			<set_variables var_part_05="1"/>
		</sequence>
		<sequence editable_state="false" name="'spawn_debris_6'" triggable="false">
			<sound action="'play'" event="'USM_BRK'" object="'rp_marshal_shield_1'"/>
			<object enabled="false" name="'g_shield_debris_6'"/>
			<spawn_unit inherit_destroy="true" name="'units/pd2_mod_halloween/characters/ene_acc_marshal_shield_1/marshal_shield_debris_6'" position="object_pos('rp_marshal_shield_1')" rotation="object_rot('rp_marshal_shield_1')"/>
			<set_variables var_part_06="1"/>
		</sequence>
		<sequence editable_state="false" name="'add_loop_break'" triggable="false">
			<set_variables var_loop_break="vars.var_loop_break + 1"/>
		</sequence>
		<sequence editable_state="false" name="'debris_run_1'" triggable="false">
			<run_sequence filter="'filter_already_part_01'" name="'random_debris'"/>
			<run_sequence filter="'filter_part_01'" name="'spawn_debris_1'"/>
		</sequence>
		<sequence editable_state="false" name="'debris_run_2'" triggable="false">
			<run_sequence filter="'filter_already_part_02'" name="'random_debris'"/>
			<run_sequence filter="'filter_part_02'" name="'spawn_debris_2'"/>
		</sequence>
		<sequence editable_state="false" name="'debris_run_3'" triggable="false">
			<run_sequence filter="'filter_already_part_03'" name="'random_debris'"/>
			<run_sequence filter="'filter_part_03'" name="'spawn_debris_3'"/>
		</sequence>
		<sequence editable_state="false" name="'debris_run_4'" triggable="false">
			<run_sequence filter="'filter_already_part_04'" name="'random_debris'"/>
			<run_sequence filter="'filter_part_04'" name="'spawn_debris_4'"/>
		</sequence>
		<sequence editable_state="false" name="'debris_run_5'" triggable="false">
			<run_sequence filter="'filter_already_part_05'" name="'random_debris'"/>
			<run_sequence filter="'filter_part_05'" name="'spawn_debris_5'"/>
		</sequence>
		<sequence editable_state="false" name="'debris_run_6'" triggable="false">
			<run_sequence filter="'filter_already_part_06'" name="'random_debris'"/>
			<run_sequence filter="'filter_part_06'" name="'spawn_debris_6'"/>
		</sequence>
		<sequence editable_state="true" name="'random_debris'" triggable="true">
			<run_sequence filter="'filter_already_all_parts'" name="'add_loop_break'"/>
			<run_sequence filter="'filter_loop_break'" name="'debris_run_'..pick('1','2','3','4','5','6')"/>
		</sequence>
		<sequence editable_state="false" name="'reset_body_damage'" triggable="false">
			<set_damage bullet="0"/>
		</sequence>
		<body name="'light_01'">
			<endurance bullet="1">
				<run_sequence filter="'filter_light_1_enabled'" name="'int_seq_light_1_hit'"/>
				<run_sequence filter="'filter_can_flash_light_1'" name="'int_seq_light_1_break'"/>
				<run_sequence filter="'filter_light_1_enabled'" name="'reset_body_damage'"/>
			</endurance>
		</body>
		<body name="'light_02'">
			<endurance bullet="1">
				<run_sequence filter="'filter_light_2_enabled'" name="'int_seq_light_2_hit'"/>
				<run_sequence filter="'filter_can_flash_light_2'" name="'int_seq_light_2_break'"/>
				<run_sequence filter="'filter_light_2_enabled'" name="'reset_body_damage'"/>
			</endurance>
		</body>
		<body name="'held_body'">
			<endurance damage="10" explosion="200">
				<run_sequence name="'random_debris'"/>
			</endurance>
			<endurance damage="20" explosion="200">
				<run_sequence name="'random_debris'"/>
			</endurance>
			<endurance damage="30" explosion="200">
				<run_sequence name="'random_debris'"/>
			</endurance>
			<endurance damage="40" explosion="200">
				<run_sequence name="'random_debris'"/>
			</endurance>
			<endurance damage="50" explosion="200">
				<run_sequence name="'random_debris'"/>
			</endurance>
			<endurance damage="60" explosion="200">
				<run_sequence name="'random_debris'"/>
			</endurance>
			<endurance damage="70" explosion="200">
				<run_sequence filter="'filter_shield_not_broken'" name="'int_seq_shield_break'"/>
			</endurance>
		</body>
	</unit>
</sequence_manager>
