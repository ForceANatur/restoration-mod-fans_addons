<dynamic_object>
    <diesel orientation_object="rp_wpn_third_ass_mp44" materials="units/raid_ww2/weapons/wpn_npc_ger_stg44/wpn_npc_ger_stg44" />
    <sequence_manager file="units/raid_ww2/weapons/wpn_npc_ger_stg44/wpn_npc_ger_stg44" />
    <bodies>
    <body name="body" enabled="false" template="small_prop" pushed_by_mover="false">
            <object name="rp_wpn_third_ass_mp44" />
			
			<object name="c_box_01" collision_type="box" 		mass="0.1"	padding="-2.5"/>
			<object name="c_box_02" collision_type="box" 		mass="0.1"	padding="-2.5"/>
			<object name="c_box_03" collision_type="box" 		mass="0.3"	padding="-2.5"/>
			<object name="c_box_04" collision_type="box" 		mass="1.1" 	padding="-2.5"/>
			<object name="c_sphere_01" collision_type="sphere" 	mass="1" 	padding="-2.5"/>
			<object name="c_sphere_02" collision_type="sphere" 	mass="1.5" 	padding="-2.5"/>
			<object name="c_sphere_03" collision_type="sphere" 	mass="0.4" 	padding="-2.5"/>
			<object name="c_sphere_04" collision_type="sphere" 	mass="0.1"  padding="-2.5"/>
        </body>
    </bodies>
    <graphics>
        <graphic_group name="lod_group" enabled="true" culling_object="co_weapon">
            <lod_object name="weapon_lod">
                <object  name="g_body" enabled="true" max_draw_lod="0" max_distance="1000" />
                <object lod="1" name="g_body_lod" enabled="true" />
            </lod_object>
            <object  name="s_body" enabled="true" shadow_caster="true" />
        </graphic_group>
    </graphics>
</dynamic_object>